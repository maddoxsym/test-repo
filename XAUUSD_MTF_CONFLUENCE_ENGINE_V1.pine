//@version=6
// =============================================================================
//  XAUUSD MULTI-TIMEFRAME CONFLUENCE ENGINE V1
// =============================================================================
//  Research / decision-support indicator for XAUUSD on a 5-minute execution
//  chart. It is NOT a trading bot and NOT a one-condition signal generator.
//  A signal is only produced when a full setup sequence completes AND a
//  weighted multi-timeframe confluence score clears a configurable threshold.
//
//  ARCHITECTURE (top to bottom in this file)
//    01  Inputs (12 groups)
//    02  Types (zone objects) + generic helpers
//    03  Core chart-timeframe calculations (ATR, volatility, momentum)
//    04  Market-structure engine (shared by every timeframe)
//    05  Higher-timeframe requests (one request.security per timeframe)
//    06  Sessions, previous-day levels, session liquidity
//    07  Liquidity pools + sweep detection
//    08  Displacement
//    09  Fair value gaps (creation, mitigation, lifecycle)
//    10  Order blocks / supply-demand (creation, invalidation, lifecycle)
//    11  Premium / equilibrium / discount
//    12  Room to target + opposing-structure scan
//    13  Market regime classification
//    14  Setup families 1-4
//    15  Confluence score
//    16  Trade plan (entry, structural stop, structural targets, R:R)
//    17  Verdict engine (BUY / SELL / WAIT / NO TRADE + reason)
//    18  Trade management state machine
//    19  Visuals
//    20  Dashboard
//    21  Alerts
//
//  NON-REPAINTING MODEL
//    * Every request.security() call uses barmerge.lookahead_off.
//    * Higher-timeframe values are taken from the PREVIOUS closed HTF bar,
//      so an HTF value can never change once the chart bar has closed.
//      ("Use live (unconfirmed) HTF candles" can override this - it is OFF by
//      default and is clearly a repainting mode.)
//    * Swing points are pivot-confirmed: a swing high needs `swingLen` bars to
//      its right before it exists, so it can never be re-drawn later.
//    * With "Confirmed-candle signals only" ON (default) every state change,
//      signal, zone and management update happens on barstate.isconfirmed,
//      i.e. at M5 candle close.
//    * Historical signals are never moved, re-coloured or deleted based on
//      outcome. The only deletion is a FIFO display cap (configurable) that
//      exists purely to respect TradingView's 500-object limits.
//
//  UNAVOIDABLE TRADINGVIEW LIMITATIONS (see README section in the answer)
//    * There is no bid/ask or real spread in Pine - spread and slippage are
//      user-supplied estimates.
//    * Using the previous closed HTF bar costs up to one HTF bar of latency.
//      That is the price of never repainting; it is deliberate.
//    * While the current M5 candle is still open the dashboard, WAIT/NO TRADE
//      text, zone edges and the trailing-stop suggestion update live. They
//      settle at candle close. Confirmed BUY/SELL labels do not.
//    * Intrabar order of stop vs target cannot be known from M5 candles, so
//      management flags use candle closes / candle extremes only.
//
//  NO PROFITABILITY IS CLAIMED OR IMPLIED. Test it yourself before relying on
//  it for anything.
// =============================================================================

indicator("XAUUSD MULTI-TIMEFRAME CONFLUENCE ENGINE V1", "XAU MTF CONFLUENCE V1", overlay = true, max_lines_count = 500, max_labels_count = 500, max_boxes_count = 500, max_bars_back = 500)

// =============================================================================
// 01 - INPUTS
// =============================================================================

// --- 1 - TIMEFRAMES ----------------------------------------------------------
string G_TF = "1 - Timeframes"
string tfH1   = input.timeframe("60", "HTF direction 1 (major)",   group = G_TF, tooltip = "Overall directional context. Default H1.")
string tfM30  = input.timeframe("30", "HTF direction 2 (major)",   group = G_TF, tooltip = "Secondary directional context. Default M30.")
string tfM15  = input.timeframe("15", "Setup structure timeframe", group = G_TF, tooltip = "Setup structure and directional agreement. Default M15.")
string tfM1   = input.timeframe("1",  "Refinement timeframe",      group = G_TF, tooltip = "Optional entry refinement only. It can never create a signal on its own.")
bool   useM1  = input.bool(false, "Require refinement-timeframe agreement", group = G_TF, tooltip = "OFF by default. When ON, M1 structure must agree with the trade direction. M1 is never a standalone signal source.")
bool   confirmedOnly = input.bool(true,  "Confirmed-candle signals only", group = G_TF, tooltip = "Default ON. All state changes, signals and management updates happen only at M5 candle close.")
bool   htfLiveMode   = input.bool(false, "Use live (unconfirmed) HTF candles", group = G_TF, tooltip = "OFF = non-repainting (previous closed HTF bar). ON = faster but the HTF read can change while the HTF candle is open. Leave OFF unless you know why you want it.")
bool   warnTF        = input.bool(true,  "Warn when chart is not M5", group = G_TF)

// --- 2 - MARKET STRUCTURE ----------------------------------------------------
string G_MS = "2 - Market structure"
int    atrLenIn     = input.int(14, "ATR length (all timeframes)", minval = 2, maxval = 100, group = G_MS)
int    swingLen     = input.int(3, "M5 swing sensitivity (pivot bars each side)", minval = 1, maxval = 25, group = G_MS, tooltip = "Higher = fewer, more meaningful swings. 3-5 suits XAUUSD M5.")
int    swingLenHTF  = input.int(3, "HTF swing sensitivity (pivot bars each side)", minval = 1, maxval = 25, group = G_MS)
float  structBufAtr = input.float(0.06, "Structure-break buffer (x ATR)", minval = 0.0, maxval = 2.0, step = 0.01, group = G_MS, tooltip = "A close must clear a swing by this much before it counts as a break. Stops tiny candle noise being labelled BOS.")
int    emaFastLen   = input.int(21, "Fast EMA (pullback location only)", minval = 2, group = G_MS, tooltip = "EMAs are NOT scored as an independent confluence factor. They only help locate a continuation pullback.")
int    emaSlowLen   = input.int(50, "Slow EMA (pullback location only)", minval = 2, group = G_MS)
bool   showStructLbl= input.bool(true, "Show BOS / CHoCH / MSS labels", group = G_MS)
bool   showSwingLbl = input.bool(false, "Show HH / HL / LH / LL labels", group = G_MS)
int    maxStructLbl = input.int(18, "Max structure labels kept", minval = 2, maxval = 120, group = G_MS)

// --- 3 - LIQUIDITY -----------------------------------------------------------
string G_LQ = "3 - Liquidity"
bool   useLiqPD    = input.bool(true, "Track previous-day high / low", group = G_LQ)
bool   useLiqSess  = input.bool(true, "Track session highs / lows",    group = G_LQ)
bool   useLiqEq    = input.bool(true, "Track equal highs / lows",      group = G_LQ)
bool   useLiqSwing = input.bool(true, "Track confirmed swing high / low", group = G_LQ)
float  eqTolAtr    = input.float(0.10, "Equal high/low tolerance (x ATR)", minval = 0.01, maxval = 1.0, step = 0.01, group = G_LQ)
int    sweepValid  = input.int(15, "Sweep stays valid for (bars)", minval = 2, maxval = 200, group = G_LQ, tooltip = "How long after a sweep the reversal sequence may still complete.")
float  sweepPenAtr = input.float(0.04, "Minimum sweep penetration (x ATR)", minval = 0.0, maxval = 2.0, step = 0.01, group = G_LQ)
bool   sweepReject = input.bool(true, "Sweep must close back inside the level", group = G_LQ, tooltip = "Rejects levels that were simply broken and held.")

// --- 4 - SESSIONS ------------------------------------------------------------
string G_SE = "4 - Sessions"
string tzIn      = input.string("UTC", "Session timezone", options = ["UTC", "Exchange", "Europe/London", "Europe/Berlin", "America/New_York", "America/Chicago", "Asia/Tokyo", "Asia/Shanghai", "Asia/Dubai", "Australia/Sydney"], group = G_SE, tooltip = "All session calculations use this timezone. 'Exchange' uses the chart symbol's own timezone.")
string sessAsia  = input.session("0000-0700", "Asia session",     group = G_SE)
string sessLon   = input.session("0700-1200", "London session",   group = G_SE)
string sessNY    = input.session("1200-2100", "New York session", group = G_SE)
