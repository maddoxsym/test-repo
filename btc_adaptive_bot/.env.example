# ============================================================
#  BTC Adaptive Bot — environment template
#  Copy to .env  (cp .env.example .env)  and fill in.
#  .env is git-ignored. Never commit real credentials.
# ============================================================

# --- Bybit DEMO credentials (REQUIRED for demo trading) -----
# Get these from: bybit.com -> log in -> switch to "Demo Trading"
# -> hover your avatar -> API -> create key.
#
# These MUST be demo-trading keys. The bot sends one read-only
# request to the mainnet host to confirm they do NOT work there;
# if they do, it refuses to trade. (See docs/bybit_capabilities.md §3.)
BYBIT_DEMO_API_KEY=
BYBIT_DEMO_API_SECRET=

# There is intentionally no mainnet key setting, no "live" flag,
# and no way to point the authenticated client anywhere else.

# --- Optional news providers ---------------------------------
# All optional. With none set, the bot uses public RSS feeds and
# the built-in macro calendar, and marks news health DEGRADED
# rather than failing.
CRYPTOPANIC_API_KEY=
NEWSAPI_API_KEY=
FRED_API_KEY=

# --- Optional notifications ----------------------------------
# Leave blank to disable. The bot never requires these.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=

# --- Optional overrides --------------------------------------
# Path to the config file used by the scripts.
BTCBOT_CONFIG=config/research.yaml
# Log level: DEBUG | INFO | WARNING | ERROR
BTCBOT_LOG_LEVEL=INFO
