# ============================================================
#  BTC Adaptive Bot — environment template
#  Copy to .env  (cp .env.example .env)  and fill in.
#  .env is git-ignored. Never commit real credentials.
# ============================================================

# --- OKX DEMO credentials (REQUIRED for demo trading) --------
# Get these from: your OKX site -> log in -> switch to
# "Demo Trading" -> profile -> API -> create a DEMO API key
# (Read + Trade). OKX keys have THREE parts: key, secret, and the
# passphrase you chose when creating the key. All three are
# required.
#
# REGION: an OKX key is issued by ONE regional entity and does not
# exist on the others — presenting it to the wrong one returns
# "50119 API key doesn't exist". Set `exchange.region` in
# config/default.yaml to match the site you created the key on:
#   global -> OKX Global / UAE   (default)
#   eea    -> OKX Europe
#   us     -> OKX US
#
# These MUST be demo-trading keys. The bot sends one read-only
# request WITHOUT the demo header to confirm the key does NOT
# work against the live environment (OKX must answer 50101);
# if it does work, the bot refuses to trade.
# (See docs/okx_demo_capabilities.md §4.)
OKX_DEMO_API_KEY=
OKX_DEMO_API_SECRET=
OKX_DEMO_PASSPHRASE=

# There is intentionally no live-environment key setting, no
# "live" flag, and no way to point the authenticated client
# anywhere else or strip the x-simulated-trading header.

# --- Optional news providers ---------------------------------
# All optional. With none set, the bot uses public RSS feeds and
# the built-in macro calendar, and marks news health DEGRADED
# rather than failing.
CRYPTOPANIC_API_KEY=
NEWSAPI_API_KEY=
FRED_API_KEY=

# --- Optional notifications ----------------------------------
# Leave blank to disable. The bot never requires these.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=

# --- Optional overrides --------------------------------------
# Path to the config file used by the scripts.
BTCBOT_CONFIG=config/research.yaml
# Log level: DEBUG | INFO | WARNING | ERROR
BTCBOT_LOG_LEVEL=INFO
